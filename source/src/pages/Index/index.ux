<template>
  <div class="page">
    <!-- 置顶栏背景 -->
    <div class="top-bar-bg"></div>

    <!-- 时钟 -->
    <text class="clock-text">{{currentTime}}</text>

    <!-- 标题 -->
    <text class="app-title">{{L.appName}}</text>

    <!-- 菜单列表（可滚动） -->
    <list class="menu-list">
      <list-item class="section-header" if="{{hasPinned}}">
        <text class="section-text">{{L.pinnedSection}}</text>
      </list-item>
      <list-item class="menu-item item-pinned" for="{{pinnedItems}}" tid="id" onclick="openItem($item)" onlongpress="togglePin($item)">
        <image class="menu-icon-img" if="{{$item.hasImg}}" src="{{$item.img}}"></image>
        <div class="menu-icon-box" if="{{$item.hasIcon}}"><text class="menu-icon-text">{{$item.icon}}</text></div>
        <text class="menu-text">{{$item.label}}</text>
        <text class="pin-badge">{{L.pinBadge}}</text>
      </list-item>
      <list-item class="section-header" if="{{hasPinned}}">
        <text class="section-text">{{L.allSection}}</text>
      </list-item>
      <list-item class="menu-item" for="{{menuItems}}" tid="id" onclick="openItem($item)" onlongpress="togglePin($item)">
        <image class="menu-icon-img" if="{{$item.hasImg}}" src="{{$item.img}}"></image>
        <div class="menu-icon-box" if="{{$item.hasIcon}}"><text class="menu-icon-text">{{$item.icon}}</text></div>
        <text class="menu-text">{{$item.label}}</text>
      </list-item>
      <list-item class="menu-spacer">
        <text class="spacer-text"></text>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    border-radius: 233px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .top-bar-bg {
    width: 466px;
    height: 42px;
    position: absolute;
    top: 0px;
    left: 0px;
    z-index: 1;
    background-color: #000000;
  }

  .clock-text {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    margin-top: 8px;
    z-index: 2;
  }

  .app-title {
    color: #ffffff;
    font-size: 32px;
    font-weight: 800;
    margin-top: 3px;
    z-index: 2;
  }

  .menu-list {
    width: 430px;
    height: 378px;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .menu-item {
    width: 430px;
    height: 120px;
    border-radius: 60px;
    background-color: rgba(147, 112, 219, 0.35);
    border-width: 4px;
    border-color: #9370db;
    margin-top: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 36px;
  }

  .menu-icon-box {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
  }

  .menu-icon-img {
    width: 72px;
    height: 72px;
    margin-left: 6px;
  }

  .menu-icon-text {
    color: #ffffff;
    font-size: 36px;
    font-weight: 800;
    text-align: center;
  }

  .menu-text {
    color: #ffffff;
    font-size: 40px;
    font-weight: 800;
    margin-left: 20px;
  }

  .item-pinned {
    border-color: #6495ed;
    background-color: rgba(100, 149, 237, 0.35);
  }

  .pin-badge {
    color: #6495ed;
    font-size: 20px;
    font-weight: 800;
    margin-left: 12px;
  }

  .section-header {
    width: 430px;
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
  }

  .section-text {
    color: #9370db;
    font-size: 24px;
    font-weight: 800;
  }

  .menu-spacer {
    width: 430px;
    height: 180px;
  }

  .spacer-text {
    font-size: 1px;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import prompt from '@system.prompt'
  import i18n from '../../i18n/index.js'

  var PIN_KEY = 'index_pinned_v1'

  var MENU = [
    { id: 'standard', img: '/Common/menu_standard.png', route: '/pages/Standard' },
    { id: 'scientific', img: '/Common/menu_scientific.png', route: '/pages/Scientific' },
    { id: 'unit', img: '/Common/menu_unit.png', route: '/pages/Unit' },
    { id: 'graph', img: '/Common/menu_graph.png', route: '/pages/Graph' },
    { id: 'triangle', img: '/Common/menu_triangle.png', route: '/pages/Triangle' },
    { id: 'derivative', img: '/Common/menu_derivative.png', route: '/pages/Derivative' },
    { id: 'monotonicity', img: '/Common/menu_monotonicity.png', route: '/pages/Monotonicity' },
    { id: 'linearregression', img: '/Common/menu_linearregression.png', route: '/pages/LinearRegression' },
    { id: 'bmi', img: '/Common/menu_bmi.png', route: '/pages/BMI' },
    { id: 'currency', img: '/Common/menu_currency.png', route: '/pages/Currency' },
    { id: 'baseconverter', img: '/Common/menu_baseconverter.png', route: '/pages/BaseConverter' },
    { id: 'studytools', img: '/Common/menu_studytools.png', route: '/pages/Formulas' },
    { id: 'equation', img: '/Common/menu_equation.png', route: '/pages/Equation' },
    { id: 'inequality', img: '/Common/menu_inequality.png', route: '/pages/Inequality' },
    { id: 'inequalitygroup', img: '/Common/menu_inequalitygroup.png', route: '/pages/InequalityGroup' },
    { id: 'chemical', img: '/Common/menu_chemical.png', route: '/pages/Chemical' },
    { id: 'kinship', img: '/Common/menu_kinship.png', route: '/pages/Kinship' },
    { id: 'numbercase', img: '/Common/menu_numbercase.png', route: '/pages/NumberCase' },
    { id: 'random', img: '/Common/menu_random.png', route: '/pages/Random' },
    { id: 'history', img: '/Common/menu_history.png', route: '/pages/History' },
    { id: 'settings', img: '/Common/menu_settings.png', route: '/pages/Settings' }
  ]

  for (var mi = 0; mi < MENU.length; mi++) {
    MENU[mi].hasImg = !!MENU[mi].img
    MENU[mi].hasIcon = !MENU[mi].img
  }

  export default {
    private: {
      L: i18n.page('index'),
      currentTime: '00:00',
      menuItems: MENU,
      pinnedItems: [],
      pinnedIds: [],
      hasPinned: false
    },

    onInit() {
      var self = this
      this.applyLang()
      i18n.load(function() {
        self.applyLang()
      })
      this.updateTime()
      this.timer = setInterval(this.updateTime.bind(this), 10000)
      this.loadPins()
    },

    onShow() {
      this.applyLang()
    },

    applyLang() {
      this.L = i18n.page('index')
      for (var i = 0; i < MENU.length; i++) {
        MENU[i].label = this.L.menu[MENU[i].id]
      }
      this.menuItems = MENU.slice()
      this.rebuildPinned()
    },

    onDestroy() {
      if (this.timer) {
        clearInterval(this.timer)
      }
    },

    updateTime() {
      var now = new Date()
      var h = now.getHours()
      var m = now.getMinutes()
      if (h < 10) h = '0' + h
      if (m < 10) m = '0' + m
      this.currentTime = h + ':' + m
    },

    loadPins() {
      var self = this
      storage.get({
        key: PIN_KEY,
        success: function(data) {
          if (data) {
            try {
              var ids = JSON.parse(data)
              if (ids && ids.length > 0) {
                self.pinnedIds = ids
                self.rebuildPinned()
              }
            } catch (e) {}
          }
        }
      })
    },

    rebuildPinned() {
      var pinned = []
      for (var i = 0; i < this.pinnedIds.length; i++) {
        for (var j = 0; j < MENU.length; j++) {
          if (MENU[j].id === this.pinnedIds[i]) {
            pinned.push(MENU[j])
            break
          }
        }
      }
      this.pinnedItems = pinned
      this.hasPinned = pinned.length > 0
    },

    togglePin(item) {
      var id = item.id
      var idx = this.pinnedIds.indexOf(id)
      if (idx >= 0) {
        this.pinnedIds.splice(idx, 1)
        prompt.showToast({ message: this.L.unpinnedToast })
      } else {
        this.pinnedIds.push(id)
        prompt.showToast({ message: this.L.pinnedToast + item.label })
      }
      this.rebuildPinned()
      storage.set({
        key: PIN_KEY,
        value: JSON.stringify(this.pinnedIds)
      })
    },

    openItem(item) {
      router.push({ uri: item.route })
    }
  }
</script>
