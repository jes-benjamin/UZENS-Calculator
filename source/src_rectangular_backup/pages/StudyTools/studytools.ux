<template>
  <div class="page">
    <!-- 退出按钮 -->
    <div class="exit-btn" onclick="exitApp"><text class="exit-icon">✕</text></div>

    <div class="title-bar">
      <text class="title-text">高中学习工具</text>
    </div>

    <text class="hint-text">诚信考试，作弊可耻，请勿在考试时使用本功能</text>

    <list class="menu-list">
      <list-item class="menu-item" onclick="openFormulas">
        <text class="menu-icon-text">公式</text>
        <text class="menu-text">高中常用数学公式</text>
      </list-item>
      <list-item class="menu-item" onclick="openSolving">
        <text class="menu-icon-text">解题</text>
        <text class="menu-text">高中解题思路</text>
      </list-item>
      <list-item class="menu-spacer">
        <text class="spacer-text"></text>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page {
    width: 432px;
    height: 514px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .title-bar {
    width: 390px;
    height: 44px;
    margin-top: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .title-text {
    color: #ffffff;
    font-size: 32px;
    font-weight: 800;
  }

  .menu-list {
    width: 400px;
    height: 420px;
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .menu-item {
    width: 400px;
    height: 120px;
    border-radius: 60px;
    background-color: rgba(147, 112, 219, 0.35);
    border-width: 4px;
    border-color: #9370db;
    margin-top: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 24px;
    padding-right: 36px;
  }

  .menu-icon-text {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: #9370db;
    color: #000000;
    font-size: 28px;
    font-weight: 800;
    text-align: center;
    line-height: 80px;
  }

  .menu-text {
    color: #ffffff;
    font-size: 34px;
    font-weight: 800;
    margin-left: 20px;
  }

  .menu-spacer {
    width: 400px;
    height: 40px;
  }

  .spacer-text {
    font-size: 1px;
  }

  .hint-text {
    color: #ff0000;
    font-size: 14px;
    text-align: center;
    margin-top: 6px;
  }
  .exit-btn {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    background-color: rgba(255, 255, 255, 0.15);
    position: absolute;
    top: 5px;
    left: 8px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .exit-icon {
    color: #ffffff;
    font-size: 42px;
    font-weight: 800;
    text-align: center;
  }

</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  export default {

    exitApp() {
      router.back()
    },
    private: {
      vibrationOn: true
    },

    onBackPress() {
      router.back()
      return true
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    openFormulas() {
      this.doVibrate()
      router.push({ uri: '/pages/Formulas' })
    },

    openSolving() {
      this.doVibrate()
      router.push({ uri: '/pages/Solving' })
    }
  }
</script>
