<script>
  import router from '@system.router'

  export default {
    private: {
      currentTime: '00:00'
    },

    onInit() {
      this.updateTime()
      this.timer = setInterval(this.updateTime.bind(this), 10000)
    },

    onDestroy() {
      if (this.timer) {
        clearInterval(this.timer)
      }
    },

    updateTime() {
      var now = new Date()
      var h = now.getHours()
      var m = now.getMinutes()
      if (h < 10) h = '0' + h
      if (m < 10) m = '0' + m
      this.currentTime = h + ':' + m
    },

    openStandard() {
      router.push({ uri: '/pages/Standard' })
    },

    openScientific() {
      router.push({ uri: '/pages/Scientific' })
    },

    openUnit() {
      router.push({ uri: '/pages/Unit' })
    },

    openGraph() {
      router.push({ uri: '/pages/Graph' })
    },

    openDerivative() {
      router.push({ uri: '/pages/Derivative' })
    },

    openLinearRegression() {
      router.push({ uri: '/pages/LinearRegression' })
    },

    openBMI() {
      router.push({ uri: '/pages/BMI' })
    },

    openCurrency() {
      router.push({ uri: '/pages/Currency' })
    },

    openBaseConverter() {
      router.push({ uri: '/pages/BaseConverter' })
    },

    openStudyTools() {
      router.push({ uri: '/pages/StudyTools' })
    },

    openEquation() {
      router.push({ uri: '/pages/Equation' })
    },

    openInequality() {
      router.push({ uri: '/pages/Inequality' })
    },

    openInequalityGroup() {
      router.push({ uri: '/pages/InequalityGroup' })
    },

    openChemical() {
      router.push({ uri: '/pages/Chemical' })
    },

    openKinship() {
      router.push({ uri: '/pages/Kinship' })
    },

    openNumberCase() {
      router.push({ uri: '/pages/NumberCase' })
    },

    openHistory() {
      router.push({ uri: '/pages/History' })
    },

    openSettings() {
      router.push({ uri: '/pages/Settings' })
    }
  }
</script>
