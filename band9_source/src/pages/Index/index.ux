        <text class="menu-text">解不等式</text>
      </list-item>
      <list-item class="menu-item" onclick="openInequalityGroup">
        <div class="menu-icon-box"><text class="menu-icon-text">∩</text></div>
        <text class="menu-text">解不等式组</text>
