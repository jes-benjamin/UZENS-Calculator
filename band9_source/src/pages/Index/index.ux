<style>
  .page {
    width: 192px;
    height: 490px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .top-bar-bg {
    width: 192px;
    height: 28px;
    position: absolute;
    top: 0px;
    left: 0px;
    z-index: 1;
    background-color: #000000;
  }

  .app-title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    position: absolute;
    top: 5px;
    left: 8px;
    z-index: 2;
  }

  .clock-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    position: absolute;
    top: 5px;
    right: 8px;
    z-index: 2;
  }

  .menu-list {
    width: 180px;
    height: 450px;
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .menu-item {
    width: 180px;
    height: 60px;
    border-radius: 30px;
    background-color: rgba(147, 112, 219, 0.35);
    border-width: 2px;
    border-color: #9370db;
    margin-top: 4px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 8px;
  }

  .menu-icon-box {
    width: 36px;
