<template>
  <div class="page">
    <div class="title-bar">
      <text class="title-text">函数图像</text>
    </div>

    <div class="expr-box">
      <text class="expr-text">f(x)={{funcExpr}}</text>
    </div>

    <div class="graph-box">
      <!-- 网格线（横向） -->
      <div class="grid-h-line" for="{{gridH}}" style="top:{{$item}}px"></div>
      <!-- 网格线（纵向） -->
      <div class="grid-v-line" for="{{gridV}}" style="left:{{$item}}px"></div>
      <!-- 坐标轴 -->
      <div class="axis-v"></div>
      <div class="axis-h"></div>
      <!-- 函数曲线点 -->
      <div class="curve-dot" for="{{curveDots}}" style="left:{{$item.l}}px;top:{{$item.t}}px"></div>
    </div>

    <div class="mono-box">
      <text class="mono-label">单调性: </text>
      <text class="mono-text">{{monotonicityResult}}</text>
    </div>

    <text class="tip-text" if="{{hasError}}">表达式无效，请返回修改</text>
    <text class="tip-text" if="{{curveDots.length === 0 && !hasError}}">无法绘制该函数</text>
  </div>
</template>

<style>
  .page {
    width: 212px;
    height: 520px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .title-bar {
    width: 200px;
    height: 30px;
    margin-top: 6px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .title-text {
    color: #ffffff;
    font-size: 20px;
    font-weight: 800;
  }

  .expr-box {
    width: 200px;
    height: 30px;
    border-radius: 10px;
    background-color: #1a1a1a;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .expr-text {
    width: 184px;
    height: 24px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
  }

  .graph-box {
    width: 190px;
    height: 220px;
    margin-top: 6px;
    border-radius: 10px;
    background-color: #0d0d0d;
    position: relative;
  }

  .grid-h-line {
    position: absolute;
    left: 0px;
    width: 190px;
    height: 1px;
    background-color: #1f1f1f;
  }

  .grid-v-line {
    position: absolute;
    top: 0px;
    width: 1px;
    height: 220px;
    background-color: #1f1f1f;
  }

  .axis-v {
    position: absolute;
    left: 95px;
    top: 0px;
    width: 2px;
    height: 220px;
    background-color: #666666;
  }

  .axis-h {
    position: absolute;
    left: 0px;
    top: 110px;
    width: 190px;
    height: 2px;
    background-color: #666666;
  }

  .curve-dot {
    position: absolute;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: #ffffff;
  }

  .mono-box {
    width: 200px;
    min-height: 40px;
    max-height: 120px;
    border-radius: 10px;
    background-color: #1a1a1a;
    margin-top: 6px;
    padding: 6px 8px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }

  .mono-label {
    color: #888888;
    font-size: 16px;
    font-weight: 700;
  }

  .mono-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    flex: 1;
  }

  .tip-text {
    color: #ff6b6b;
    font-size: 16px;
    font-weight: 800;
    margin-top: 4px;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var GRAPH_EXPR_KEY = 'graph_expr_v2'

  export default {
    private: {
      funcExpr: '0',
      hasError: false,
      gridH: [],
      gridV: [],
      curveDots: [],
      vibrationOn: true,
      monotonicityResult: '计算中...',
      xValue: 0
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    onShow() {
      this.buildGrid()
      this.loadExpression()
    },

    buildGrid() {
      var gh = []
      var gv = []
      // 横向网格线，每 22px 一条
      for (var y = 0; y <= 220; y += 22) {
        gh.push(y)
      }
      // 纵向网格线，每 19px 一条
      for (var x = 0; x <= 190; x += 19) {
        gv.push(x)
      }
      this.gridH = gh
      this.gridV = gv
    },

    loadExpression() {
      var self = this
      storage.get({
        key: GRAPH_EXPR_KEY,
        success: function(data) {
          self.funcExpr = data || '0'
          self.generateCurve()
          self.calculateMonotonicity()
        },
        fail: function() {
          self.funcExpr = '0'
          self.generateCurve()
          self.calculateMonotonicity()
        }
      })
    },

    calculateMonotonicity() {
      var raw = this.funcExpr.replace(/\s/g, '')
      if (raw.length === 0) {
        this.monotonicityResult = '无表达式'
        return
      }

      try {
        var monoExpr = raw
          .replace(/π/g, 'pi')
          .replace(/÷/g, '/')
          .replace(/×/g, '*')
          .replace(/e\^x/g, 'exp(x)')
          .replace(/e\^/g, 'exp(')
        if (this.isPolynomial(monoExpr)) {
          this.monotonicityResult = this.findMonotonicityPoly(monoExpr)
        } else {
          this.monotonicityResult = this.sampleMonotonicity(monoExpr)
        }
      } catch (e) {
        this.monotonicityResult = '无法分析'
      }
    },

    isPolynomial(expr) {
      var s = expr.replace(/\s/g, '')
      for (var i = 0; i < s.length; i++) {
        var c = s.charAt(i)
        if (!((c >= '0' && c <= '9') || c === 'x' || c === '+' || c === '-' || c === '*' || c === '/' || c === '^' || c === '(' || c === ')' || c === '.')) {
          return false
        }
      }
      return true
    },

    findMonotonicityPoly(expr) {
      var tokens = this.tokenize(expr)
      var result = this.parseExprRD(tokens, 0)
      var coeffs = result.coeffs

      var deriv = {}
      for (var key in coeffs) {
        if (coeffs.hasOwnProperty(key) && key !== 'const') {
          var deg = parseInt(key.substring(1))
          var newDeg = deg - 1
          var newKey = newDeg === 0 ? 'const' : 'x' + newDeg
          deriv[newKey] = (deriv[newKey] || 0) + coeffs[key] * deg
        }
      }

      var nonZero = []
      for (var k in deriv) {
        if (deriv.hasOwnProperty(k) && Math.abs(deriv[k]) > 1e-9) {
          nonZero.push({ key: k, val: deriv[k] })
        }
      }

      if (nonZero.length === 0) {
        return '函数为常数'
      }

      var maxDeg = 0
      for (var i = 0; i < nonZero.length; i++) {
        var d = nonZero[i].key === 'const' ? 0 : parseInt(nonZero[i].key.substring(1))
        if (d > maxDeg) maxDeg = d
      }

      var roots = []
      if (maxDeg === 0) {
        var c = deriv.const || 0
        return c > 0 ? '(-\u221e,+\u221e)递增' : '(-\u221e,+\u221e)递减'
      } else if (maxDeg === 1) {
        var a = deriv.x1 || 0
        var b = deriv.const || 0
        if (Math.abs(a) > 1e-9) {
          roots.push(-b / a)
        }
      } else if (maxDeg === 2) {
        var a2 = deriv.x2 || 0
        var b2 = deriv.x1 || 0
        var c2 = deriv.const || 0
        var disc = b2 * b2 - 4 * a2 * c2
        var eps = 1e-9
        if (disc > eps) {
          var r1 = (-b2 - Math.sqrt(disc)) / (2 * a2)
          var r2 = (-b2 + Math.sqrt(disc)) / (2 * a2)
          if (r1 > r2) { var tmp = r1; r1 = r2; r2 = tmp }
          roots.push(r1)
          roots.push(r2)
        } else if (Math.abs(disc) <= eps) {
          roots.push(-b2 / (2 * a2))
        } else {
          if (a2 > 0) return '(-\u221e,+\u221e)递增'
          else return '(-\u221e,+\u221e)递减'
        }
      } else {
        return this.sampleMonotonicity(expr)
      }

      var parts = []
      var startLabel = '-\u221e'

      for (var i = 0; i <= roots.length; i++) {
        var testX
        if (i === 0) {
          testX = roots[0] - 1
        } else if (i === roots.length) {
          testX = roots[roots.length - 1] + 1
        } else {
          testX = (roots[i - 1] + roots[i]) / 2
        }

        var derivVal = this.evaluatePolynomial(deriv, testX)
        var isInc = derivVal > 0
        var endLabel = (i === roots.length) ? '+\u221e' : this.formatNum(roots[i])

        if (isInc) {
          parts.push('(' + startLabel + ',' + endLabel + ')递增')
        } else {
          parts.push('(' + startLabel + ',' + endLabel + ')递减')
        }

        startLabel = endLabel
      }

      return parts.join(',')
    },

    evaluatePolynomial(coeffs, x) {
      var val = 0
      for (var key in coeffs) {
        if (coeffs.hasOwnProperty(key)) {
          if (key === 'const') {
            val += coeffs[key]
          } else {
            var deg = parseInt(key.substring(1))
            val += coeffs[key] * Math.pow(x, deg)
          }
        }
      }
      return val
    },

    sampleMonotonicity(expr) {
      var samples = [-5, -3, -1, 0, 1, 3, 5]
      var parts = []
      var startX = '-\u221e'
      var prevSign = 0

      for (var i = 0; i < samples.length; i++) {
        var d = this.numericalDerivative(expr, samples[i])
        var sign = d > 0 ? 1 : -1

        if (prevSign !== 0 && sign !== prevSign) {
          var label = this.formatNum(samples[i])
          if (prevSign > 0) {
            parts.push('(' + startX + ',' + label + ')递增')
          } else {
            parts.push('(' + startX + ',' + label + ')递减')
          }
          startX = label
        }
        prevSign = sign
      }

      if (prevSign > 0) {
        parts.push('(' + startX + ',+\u221e)递增')
      } else {
        parts.push('(' + startX + ',+\u221e)递减')
      }

      return parts.join(',')
    },

    numericalDerivative(expr, x0) {
      var h = 1e-5
      this.xValue = x0 + h
      var tokens1 = this.tokenizeGeneral(expr)
      var f1 = this.parseExprVal(tokens1, 0).value

      this.xValue = x0 - h
      var tokens2 = this.tokenizeGeneral(expr)
      var f2 = this.parseExprVal(tokens2, 0).value

      return (f1 - f2) / (2 * h)
    },

    tokenizeGeneral(s) {
      var tokens = []
      var i = 0
      while (i < s.length) {
        var ch = s.charAt(i)
        if (ch === ' ' || ch === '\t') { i++; continue }

        if (ch >= 'a' && ch <= 'z') {
          var word = ''
          while (i < s.length && s.charAt(i) >= 'a' && s.charAt(i) <= 'z') {
            word += s.charAt(i)
            i++
          }
          tokens.push(word)
          continue
        }

        if (ch === '\u03c0') {
          tokens.push('\u03c0')
          i++
          continue
        }

        if (ch === '+' || ch === '-' || ch === '*' || ch === '/' || ch === '(' || ch === ')' || ch === '^') {
          if (ch === '-' && (tokens.length === 0 || tokens[tokens.length - 1] === '(' || tokens[tokens.length - 1] === '+' || tokens[tokens.length - 1] === '-' || tokens[tokens.length - 1] === '*' || tokens[tokens.length - 1] === '/')) {
            var num = '-'
            i++
            while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
              num += s.charAt(i)
              i++
            }
            tokens.push(num)
            continue
          }
          tokens.push(ch)
          i++
        } else if (ch === '^') {
          tokens.push(ch)
          i++
        } else if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num2 = ''
          while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
            num2 += s.charAt(i)
            i++
          }
          tokens.push(num2)
        } else {
          i++
        }
      }
      return tokens
    },

    parseExprVal(tokens, pos) {
      var res = this.parseTermVal(tokens, pos)
      var val = res.value
      var i = res.pos
      while (i < tokens.length && (tokens[i] === '+' || tokens[i] === '-')) {
        var op = tokens[i]
        var termRes = this.parseTermVal(tokens, i + 1)
        if (op === '+') val += termRes.value
        else val -= termRes.value
        i = termRes.pos
      }
      return { value: val, pos: i }
    },

    parseTermVal(tokens, pos) {
      var res = this.parseFactorVal(tokens, pos)
      var val = res.value
      var i = res.pos
      while (i < tokens.length) {
        if (tokens[i] === '*' || tokens[i] === '/') {
          var op = tokens[i]
          var factorRes = this.parseFactorVal(tokens, i + 1)
          if (op === '*') val *= factorRes.value
          else val /= factorRes.value
          i = factorRes.pos
        } else if (tokens[i] === '+' || tokens[i] === '-') {
          break
        } else if (tokens[i] === ')') {
          break
        } else {
          var factorRes2 = this.parseFactorVal(tokens, i)
          val *= factorRes2.value
          i = factorRes2.pos
        }
      }
      return { value: val, pos: i }
    },

    parseFactorVal(tokens, pos) {
      if (pos >= tokens.length) return { value: 0, pos: pos }

      if (tokens[pos] === '-') {
        var res = this.parseFactorVal(tokens, pos + 1)
        return { value: -res.value, pos: res.pos }
      }

      var primaryRes = this.parsePrimaryVal(tokens, pos)
      var val = primaryRes.value
      var i = primaryRes.pos

      if (i < tokens.length && tokens[i] === '^') {
        var expRes = this.parseFactorVal(tokens, i + 1)
        val = Math.pow(val, expRes.value)
        i = expRes.pos
      }

      return { value: val, pos: i }
    },

    parsePrimaryVal(tokens, pos) {
      if (pos >= tokens.length) return { value: 0, pos: pos }
      var t = tokens[pos]

      if (t === '(') {
        var exprRes = this.parseExprVal(tokens, pos + 1)
        var endPos = exprRes.pos
        if (endPos < tokens.length && tokens[endPos] === ')') endPos++
        return { value: exprRes.value, pos: endPos }
      }

      if (t === 'x') return { value: this.xValue, pos: pos + 1 }
      if (t === 'e') return { value: Math.E, pos: pos + 1 }
      if (t === 'pi') return { value: Math.PI, pos: pos + 1 }
      if (t === '\u03c0') return { value: Math.PI, pos: pos + 1 }

      if (t === 'sin' || t === 'cos' || t === 'tan' || t === 'log' || t === 'ln' || t === 'lg' || t === 'sqrt' || t === 'exp') {
        var nextPos = pos + 1
        if (nextPos < tokens.length && tokens[nextPos] === '(') {
          var argRes = this.parseExprVal(tokens, nextPos + 1)
          var argVal = argRes.value
          var afterArg = argRes.pos
          if (afterArg < tokens.length && tokens[afterArg] === ')') afterArg++
          var funcVal
          if (t === 'sin') funcVal = Math.sin(argVal)
          else if (t === 'cos') funcVal = Math.cos(argVal)
          else if (t === 'tan') funcVal = Math.tan(argVal)
          else if (t === 'ln') funcVal = Math.log(argVal)
          else if (t === 'log') funcVal = Math.log10(argVal)
          else if (t === 'lg') funcVal = Math.log10(argVal)
          else if (t === 'sqrt') funcVal = Math.sqrt(argVal)
          else if (t === 'exp') funcVal = Math.exp(argVal)
          return { value: funcVal, pos: afterArg }
        }
        return { value: 0, pos: pos + 1 }
      }

      var num = parseFloat(t)
      if (!isNaN(num)) {
        return { value: num, pos: pos + 1 }
      }

      return { value: 0, pos: pos + 1 }
    },

    tokenize(s) {
      var tokens = []
      var i = 0
      while (i < s.length) {
        var ch = s.charAt(i)
        if (ch === '+' || ch === '-' || ch === '*' || ch === '/' || ch === '(' || ch === ')') {
          if (ch === '-' && (tokens.length === 0 || tokens[tokens.length - 1] === '(' || tokens[tokens.length - 1] === '+' || tokens[tokens.length - 1] === '-' || tokens[tokens.length - 1] === '*' || tokens[tokens.length - 1] === '/')) {
            var num = '-'
            i++
            while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
              num += s.charAt(i)
              i++
            }
            tokens.push(num)
            continue
          }
          tokens.push(ch)
          i++
        } else if (ch === '^') {
          tokens.push(ch)
          i++
        } else if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num2 = ''
          while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
            num2 += s.charAt(i)
            i++
          }
          tokens.push(num2)
        } else if (ch === 'x' || ch === 'y') {
          tokens.push(ch)
          i++
        } else {
          i++
        }
      }
      return tokens
    },

    parseExprRD(tokens, pos) {
      var sign = 1
      if (pos < tokens.length && tokens[pos] === '-') {
        sign = -1
        pos++
      } else if (pos < tokens.length && tokens[pos] === '+') {
        pos++
      }
      var res = this.parseTerm(tokens, pos)
      var coeffs = res.coeffs
      if (sign === -1) {
        for (var key in coeffs) {
          if (coeffs.hasOwnProperty(key)) {
            coeffs[key] = -coeffs[key]
          }
        }
      }
      var i = res.pos
      while (i < tokens.length && (tokens[i] === '+' || tokens[i] === '-')) {
        var op = tokens[i]
        var termRes = this.parseTerm(tokens, i + 1)
        for (var key2 in termRes.coeffs) {
          var val = termRes.coeffs[key2]
          if (op === '-') val = -val
          coeffs[key2] = (coeffs[key2] || 0) + val
        }
        i = termRes.pos
      }
      return { coeffs: coeffs, pos: i }
    },

    parseTerm(tokens, pos) {
      var res = this.parseFactor(tokens, pos)
      var coeffs = res.coeffs
      var i = res.pos
      while (i < tokens.length) {
        if (tokens[i] === '*' || tokens[i] === '/') {
          var op = tokens[i]
          var factorRes = this.parseFactor(tokens, i + 1)
          if (op === '*') {
            coeffs = this.multiplyPoly(coeffs, factorRes.coeffs)
          } else {
            coeffs = this.dividePoly(coeffs, factorRes.coeffs)
          }
          i = factorRes.pos
        } else if (tokens[i] === '(' || tokens[i] === 'x' || tokens[i] === 'y') {
          var factorRes2 = this.parseFactor(tokens, i)
          coeffs = this.multiplyPoly(coeffs, factorRes2.coeffs)
          i = factorRes2.pos
        } else {
          break
        }
      }
      return { coeffs: coeffs, pos: i }
    },

    parseFactor(tokens, pos) {
      if (pos >= tokens.length) return { coeffs: {}, pos: pos }
      var t = tokens[pos]

      if (t === '(') {
        var exprRes = this.parseExprRD(tokens, pos + 1)
        var endPos = exprRes.pos
        if (endPos < tokens.length && tokens[endPos] === ')') {
          endPos++
        }
        return { coeffs: exprRes.coeffs, pos: endPos }
      }

      if (t === 'x' || t === 'y') {
        var coeff = 1
        if (pos + 1 < tokens.length && tokens[pos + 1] === '^') {
          var power = parseInt(tokens[pos + 2])
          if (!isNaN(power) && power >= 1) {
            var key = t + power
            var obj = {}
            obj[key] = coeff
            return { coeffs: obj, pos: pos + 3 }
          }
        }
        var obj2 = {}
        obj2[t + '1'] = coeff
        return { coeffs: obj2, pos: pos + 1 }
      }

      var num = parseFloat(t)
      if (!isNaN(num)) {
        if (pos + 1 < tokens.length && (tokens[pos + 1] === 'x' || tokens[pos + 1] === 'y')) {
          var varToken = tokens[pos + 1]
          var varCoeff = num
          if (pos + 2 < tokens.length && tokens[pos + 2] === '^') {
            var varPower = parseInt(tokens[pos + 3])
            if (!isNaN(varPower) && varPower >= 1) {
              var obj3 = {}
              obj3[varToken + varPower] = varCoeff
              return { coeffs: obj3, pos: pos + 4 }
            }
          }
          var obj4 = {}
          obj4[varToken + '1'] = varCoeff
          return { coeffs: obj4, pos: pos + 2 }
        }
        return { coeffs: { const: num }, pos: pos + 1 }
      }

      return { coeffs: {}, pos: pos + 1 }
    },

    multiplyPoly(c1, c2) {
      var result = {}
      for (var k1 in c1) {
        if (!c1.hasOwnProperty(k1)) continue
        for (var k2 in c2) {
          if (!c2.hasOwnProperty(k2)) continue
          var v = c1[k1] * c2[k2]
          var deg1 = k1 === 'const' ? 0 : parseInt(k1.substring(1))
          var deg2 = k2 === 'const' ? 0 : parseInt(k2.substring(1))
          var newDeg = deg1 + deg2
          var newKey = newDeg === 0 ? 'const' : 'x' + newDeg
          result[newKey] = (result[newKey] || 0) + v
        }
      }
      return result
    },

    dividePoly(c1, c2) {
      var keys = Object.keys(c2)
      if (keys.length === 1 && keys[0] === 'const') {
        var divisor = c2.const
        if (divisor === 0) return c1
        var result = {}
        for (var k in c1) {
          if (c1.hasOwnProperty(k)) {
            result[k] = c1[k] / divisor
          }
        }
        return result
      }
      return c1
    },

    formatNum(n) {
      var rounded = Math.round(n * 100000) / 100000
      if (Math.abs(rounded - Math.round(rounded)) < 0.000001) {
        return String(Math.round(rounded))
      }
      var str = String(rounded)
      if (str.length > 10) {
        str = rounded.toExponential(4)
      }
      return str
    },

    generateCurve() {
      var w = 190
      var cx = 95
      var cy = 110
      var scale = 15
      var dots = []

      this.hasError = false

      try {
        var expr = this.prepareExpression(this.funcExpr)
        // 采样间隔 4px
        for (var px = 0; px < w; px += 4) {
          var x = (px - cx) / scale
          var y = this.evalExpression(expr, x)
          if (isNaN(y) || !isFinite(y) || Math.abs(y) > 1000) {
            continue
          }
          var py = cy - y * scale
          if (py < 0 || py > 220) {
            continue
          }
          dots.push({ l: px, t: Math.round(py) })
        }
      } catch (e) {
        this.hasError = true
      }

      this.curveDots = dots
    },

    prepareExpression(expr) {
      var out = expr || '0'
      out = out.replace(/ /g, '')
      out = out.replace(/π/g, 'pi')
      out = out.replace(/÷/g, '/')
      out = out.replace(/×/g, '*')
      out = out.replace(/e\^x/g, 'exp(x)')
      out = out.replace(/e\^/g, 'exp(')
      out = this.replacePower(out)
      out = this.addImplicitMultiply(out)
      return out
    },

    replacePower(expr) {
      var out = expr
      out = out.replace(/x\^2/g, '(x^2)')
      out = out.replace(/x\^3/g, '(x^3)')
      return out
    },

    addImplicitMultiply(expr) {
      var out = expr
      out = out.replace(/([0-9.])x/g, '$1*x')
      out = out.replace(/x([0-9.])/g, 'x*$1')
      out = out.replace(/([0-9.])\(/g, '$1*(')
      out = out.replace(/\)([0-9.])/g, ')*$1')
      out = out.replace(/\)x/g, ')*x')
      out = out.replace(/x\(/g, 'x*(')
      out = out.replace(/([0-9.])(sin|cos|tan|sqrt|log|ln|lg|exp)/g, '$1*$2')
      out = out.replace(/\)(sin|cos|tan|sqrt|log|ln|lg|exp)/g, ')*$1')
      out = out.replace(/e\(/g, 'e*(')
      return out
    },

    evalExpression(expr, xValue) {
      var text = expr
      var index = 0

      function peek() {
        return text.charAt(index)
      }

      function eat(ch) {
        if (peek() === ch) {
          index++
          return true
        }
        return false
      }

      function parse() {
        var value = parseAddSub()
        if (index < text.length) {
          throw new Error('bad expr')
        }
        return value
      }

      function parseAddSub() {
        var value = parseMulDiv()
        while (index < text.length) {
          if (eat('+')) {
            value = value + parseMulDiv()
          } else if (eat('-')) {
            value = value - parseMulDiv()
          } else {
            break
          }
        }
        return value
      }

      function parseMulDiv() {
        var value = parsePower()
        while (index < text.length) {
          if (eat('*')) {
            value = value * parsePower()
          } else if (eat('/')) {
            value = value / parsePower()
          } else {
            break
          }
        }
        return value
      }

      function parsePower() {
        var value = parseUnary()
        if (eat('^')) {
          value = Math.pow(value, parsePower())
        }
        return value
      }

      function parseUnary() {
        if (eat('+')) return parseUnary()
        if (eat('-')) return -parseUnary()
        return parsePrimary()
      }

      function parsePrimary() {
        var ch = peek()
        if (eat('(')) {
          var value = parseAddSub()
          if (!eat(')')) {
            throw new Error('missing )')
          }
          return value
        }
        if ((ch >= '0' && ch <= '9') || ch === '.') {
          return parseNumber()
        }
        if (ch === 'x') {
          index++
          return xValue
        }
        return parseName()
      }

      function parseNumber() {
        var start = index
        while (index < text.length) {
          var ch = peek()
          if ((ch >= '0' && ch <= '9') || ch === '.') {
            index++
          } else {
            break
          }
        }
        return parseFloat(text.substring(start, index))
      }

      function parseName() {
        var start = index
        while (index < text.length) {
          var ch = peek()
          if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
            index++
          } else {
            break
          }
        }
        var name = text.substring(start, index)
        if (name === 'pi') return Math.PI
        if (!eat('(')) {
          throw new Error('bad name')
        }
        var arg = parseAddSub()
        if (!eat(')')) {
          throw new Error('missing )')
        }
        if (name === 'sin') return Math.sin(arg)
        if (name === 'cos') return Math.cos(arg)
        if (name === 'tan') return Math.tan(arg)
        if (name === 'sqrt') return Math.sqrt(arg)
        if (name === 'ln') return Math.log(arg)
        if (name === 'log') return Math.log(arg) / Math.LN10
        if (name === 'lg') return Math.log(arg) / Math.LN10
        if (name === 'exp') return Math.exp(arg)
        throw new Error('unknown name')
      }

      return parse()
    }
  }
</script>
