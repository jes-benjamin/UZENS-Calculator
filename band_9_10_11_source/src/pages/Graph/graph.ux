<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var GRAPH_EXPR_KEY = 'graph_expr_v2'

  var LABELS = ['数字输入', '运算符号', '函数预设']
  var TOTAL = 3

  var presets = {
    'sin': 'sin(x)',
    'cos': 'cos(x)',
    'tan': 'tan(x)',
    'x^2': 'x^2',
    'x^3': 'x^3',
    'sqrt': 'sqrt(x)',
    'ln': 'ln(x)',
    'log': 'log(x)',
    'lg': 'lg(x)',
    'e^x': 'e^x',
    'abs': 'abs(x)'
  }

  export default {
    goBack() {
      router.back()
    },

    private: {
      funcExpr: '',
      keyPage: 0,
      vibrationOn: true
    },

    computed: {
      displayExpression() {
        return this.funcExpr || '输入函数如: x^2+3x'
      },
      currentLabel() {
        return LABELS[this.keyPage]
      }
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    prevPage() {
      this.doVibrate()
      this.keyPage = this.keyPage > 0 ? this.keyPage - 1 : TOTAL - 1
    },

    nextPage() {
      this.doVibrate()
      this.keyPage = this.keyPage < TOTAL - 1 ? this.keyPage + 1 : 0
    },

    setPreset(key) {
      this.doVibrate()
      this.funcExpr += presets[key]
    },

    appendToken(token) {
      this.doVibrate()
      if (token === 'e') {
        this.funcExpr += 'e'
      } else if (token === 'π') {
        this.funcExpr += 'π'
      } else if (this.funcExpr === '' && (token === '+' || token === '*' || token === '/' || token === '^')) {
        this.funcExpr = token
      } else {
        this.funcExpr += token
      }
    },

    deleteToken() {
      this.doVibrate()
      if (this.funcExpr.length <= 1) {
        this.funcExpr = ''
      } else {
        this.funcExpr = this.funcExpr.substring(0, this.funcExpr.length - 1)
      }
    },

    clearExpr() {
      this.doVibrate()
      this.funcExpr = ''
    },

    openResult() {
      this.doVibrate()
      var expr = this.funcExpr || '0'
      storage.set({
        key: GRAPH_EXPR_KEY,
        value: expr,
        success: function() {
          router.push({ uri: '/pages/GraphResult' })
        },
        fail: function() {
          router.push({ uri: '/pages/GraphResult' })
        }
      })
    }
  }
</script>
