        <div class="key key-soft" onclick="toggleMode"><text class="mode-text">{{isUpper ? '大' : '小'}}</text></div>
      </list-item>
<list-item class="kb-spacer"><text class="spacer-text"></text></list-item>
    </list>
    <div class="top-back" onclick="goBack"><text class="top-back-text">‹</text></div>
  </div>
</template>

