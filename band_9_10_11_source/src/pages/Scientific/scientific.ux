<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  const LABELS = ['数字输入', '运算功能', '科学函数']
  const TOTAL = 3
  const HISTORY_KEY = 'calc_history_v2'

  export default {
    goBack() {
      router.back()
    },

    private: {
      expression: '',
      result: '0',
      justSolved: false,
      keyPage: 0,
      angleMode: 'DEG',
      vibrationOn: true
    },

    computed: {
      displayExpression() {
        return this.expression || '0'
      },
      currentLabel() {
        return LABELS[this.keyPage]
      }
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    prevPage() {
      this.doVibrate()
      this.keyPage = this.keyPage > 0 ? this.keyPage - 1 : TOTAL - 1
    },

    nextPage() {
      this.doVibrate()
      this.keyPage = this.keyPage < TOTAL - 1 ? this.keyPage + 1 : 0
    },

    clearAll() {
      this.doVibrate()
      this.expression = ''
      this.result = '0'
      this.justSolved = false
    },

    deleteLast() {
      this.doVibrate()
      if (this.justSolved) {
        this.clearAll()
        return
      }
      if (this.expression.length > 1) {
        this.expression = this.expression.substring(0, this.expression.length - 1)
        this.result = this.expression
      } else {
        this.expression = ''
        this.result = '0'
      }
    },

    pressNumber(num) {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = ''
        this.result = '0'
        this.justSolved = false
      }
      this.expression += num
      this.result = this.expression
    },

    pressDot() {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = '0.'
        this.justSolved = false
      } else {
        var part = this.getLastNumber(this.expression)
        if (part.indexOf('.') === -1) {
          this.expression += part === '' ? '0.' : '.'
        }
      }
      this.result = this.expression
    },

    pressOperator(op) {
      this.doVibrate()
      if (this.justSolved) {
        this.expression = this.result
        this.justSolved = false
      }
      if (this.expression === '') {
        if (op === '-') this.expression = '-'
        this.result = this.expression || '0'
        return
      }
      var last = this.expression.charAt(this.expression.length - 1)
      if (this.isOperator(last)) {
        this.expression = this.expression.substring(0, this.expression.length - 1) + op
      } else {
        this.expression += op
      }
      this.result = this.expression
    },

    pressParen(paren) {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = ''
        this.justSolved = false
      }
      this.expression += paren
      this.result = this.expression
    },

    pressFunction(name) {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = ''
        this.justSolved = false
      }
      this.expression += name + '('
      this.result = this.expression
    },

    pressConstant(name) {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = ''
        this.justSolved = false
      }
      this.expression += name === 'PI' ? 'π' : 'e'
      this.result = this.expression
    },

    pressSquare() {
      this.doVibrate()
      this.expression = this.wrapLastValue(this.expression, 'square')
      this.result = this.expression
    },

    pressReciprocal() {
      this.doVibrate()
      this.expression = this.wrapLastValue(this.expression, 'reciprocal')
      this.result = this.expression
    },

    pressFactorial() {
      this.doVibrate()
      if (this.expression !== '') {
        this.expression += '!'
        this.result = this.expression
      }
    },

    toggleSign() {
      this.doVibrate()
      if (this.expression === '' || this.expression === '0') {
        this.expression = '-'
      } else if (this.expression.charAt(0) === '-') {
        this.expression = this.expression.substring(1)
      } else {
        this.expression = '-' + this.expression
      }
      this.result = this.expression || '0'
      this.justSolved = false
    },

    calculate() {
      this.doVibrate()
      try {
        if (this.expression === '') return
        var original = this.expression
        var expr = this.prepareExpression(this.expression)
        var factorial = function(n) {
          var num = Math.floor(n)
          if (num < 0 || num > 170) return NaN
          var res = 1
          for (var i = 2; i <= num; i++) res *= i
          return res
        }
        var log10 = function(n) { return Math.log(n) / Math.LN10 }
        var fn = new Function('factorial', 'log10', 'return ' + expr)
        var value = fn(factorial, log10)
        if (isNaN(value) || !isFinite(value)) {
          this.result = '错误'
        } else {
          this.result = this.formatResult(value)
          this.addHistory(original, this.result)
        }
        this.expression = ''
        this.justSolved = true
      } catch (e) {
        this.result = '错误'
        this.expression = ''
        this.justSolved = true
      }
    },

    addHistory(expr, result) {
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var list = []
          if (data) {
            try { list = JSON.parse(data) } catch (e) { list = [] }
          }
          list.push({ type: '计算器', expr: expr, result: result })
          if (list.length > 30) list = list.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(list) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: '计算器', expr: expr, result: result }]) })
        }
      })
    },

    prepareExpression(expr) {
      var out = expr.replace(/×/g, '*').replace(/÷/g, '/').replace(/−/g, '-')
      out = out.replace(/π/g, 'Math.PI')
      out = out.replace(/\be\b/g, 'Math.E')
      out = out.replace(/\^/g, '**')
      out = out.replace(/square\(([^()]*)\)/g, 'Math.pow($1,2)')
      out = out.replace(/reciprocal\(([^()]*)\)/g, '(1/($1))')
      out = out.replace(/(\d+(\.\d+)?)!/g, 'factorial($1)')
      if (this.angleMode === 'DEG') {
        out = out.replace(/sin\(/g, 'Math.sin(Math.PI/180*')
        out = out.replace(/cos\(/g, 'Math.cos(Math.PI/180*')
        out = out.replace(/tan\(/g, 'Math.tan(Math.PI/180*')
      } else {
        out = out.replace(/sin\(/g, 'Math.sin(')
        out = out.replace(/cos\(/g, 'Math.cos(')
        out = out.replace(/tan\(/g, 'Math.tan(')
      }
      out = out.replace(/log\(/g, 'log10(')
      out = out.replace(/ln\(/g, 'Math.log(')
      out = out.replace(/sqrt\(/g, 'Math.sqrt(')
      out = out.replace(/abs\(/g, 'Math.abs(')
      return out
    },

    wrapLastValue(expr, fnName) {
      if (expr === '') return fnName + '(0)'
      var end = expr.length
      var start = end - 1
      while (start >= 0) {
        var ch = expr.charAt(start)
        if ((ch >= '0' && ch <= '9') || ch === '.' || ch === 'π' || ch === 'e') start--
        else break
      }
      var before = expr.substring(0, start + 1)
      var target = expr.substring(start + 1, end)
      if (target === '') return expr
      return before + fnName + '(' + target + ')'
    },

    formatResult(value) {
      var text = String(parseFloat(value.toFixed(10)))
      if (text.length > 12) text = value.toExponential(5)
      return text
    },

    getLastNumber(expr) {
      var number = ''
      for (var i = expr.length - 1; i >= 0; i--) {
        var ch = expr.charAt(i)
        if ((ch >= '0' && ch <= '9') || ch === '.') number = ch + number
        else break
      }
      return number
    },

    isOperator(ch) {
      return ch === '+' || ch === '-' || ch === '*' || ch === '/' || ch === '^'
    }
  }
</script>
