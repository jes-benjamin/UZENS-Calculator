  <div class="page">
    <div class="header-bar">
      <text class="header-title">设置</text>
    </div>

    <list class="settings-list">
      <list-item class="setting-item" onclick="toggleVibration">
        <text class="setting-label">按键震动反馈</text>
        <image class="toggle-img" src="{{vibrationOn ? '/Common/toggle_on.png' : '/Common/toggle_off.png'}}"></image>
      </list-item>

      <list-item class="setting-item" onclick="toggleAutoCalc">
        <text class="setting-label">化学方程式自动计算</text>
        <image class="toggle-img" src="{{autoCalcOn ? '/Common/toggle_on.png' : '/Common/toggle_off.png'}}"></image>
      </list-item>

      <list-item class="desc-item">
        <div class="setting-desc">
          <text class="desc-text">开启后输入化学方程式将自动运算结果，</text>
          <text class="desc-text">关闭后仅进行配平。</text>
        </div>
      </list-item>

      <list-item class="setting-item" onclick="toggleSmoothCurve">
        <text class="setting-label">图像平滑曲线</text>
        <image class="toggle-img" src="{{smoothOn ? '/Common/toggle_on.png' : '/Common/toggle_off.png'}}"></image>
      </list-item>

      <list-item class="desc-item">
        <div class="setting-desc">
          <text class="desc-text">开启后函数图像采样点增至150个，</text>
          <text class="desc-text">曲线更平滑；关闭则使用默认采样。</text>
        </div>
      </list-item>

      <list-item class="setting-item setting-disabled">
        <text class="setting-label">应用后台运行</text>
        <div class="toggle-disabled">
          <div class="toggle-disabled-knob"></div>
        </div>
      </list-item>

      <list-item class="desc-item">
        <div class="setting-desc">
          <text class="desc-text">设备不支持</text>
        </div>
      </list-item>

      <list-item class="setting-item" onclick="openReward">
        <text class="setting-label">赞赏我们</text>
      </list-item>

      <list-item class="setting-item" onclick="openAbout">
        <text class="setting-label">关于应用</text>
      </list-item>

      <list-item class="bottom-spacer">
        <text class="spacer-text"></text>
      </list-item>
    </list>
    <div class="top-back" onclick="goBack"><text class="top-back-text">‹</text></div>
  </div>
</template>

<style>
  .page {
    width: 192px;
    height: 470px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-bar {
    width: 176px;
    height: 30px;
    margin-top: 4px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .header-title {
    color: #ffffff;
    font-size: 20px;
    font-weight: 800;
  }

  .settings-list {
    width: 188px;
    height: 432px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .setting-item {
    width: 176px;
    height: 56px;
    border-radius: 14px;
    background-color: rgba(128, 128, 128, 0.35);
    border-width: 2px;
    border-color: #888888;
    margin-top: 6px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 10px;
  }

  .setting-disabled {
    justify-content: space-between;
  }

  .desc-item {
    width: 176px;
    margin-top: 3px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 12px;
  }

  .setting-desc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .setting-label {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
  }

  .toggle-img {
    width: 36px;
    height: 18px;
  }

  .toggle-disabled {
    width: 36px;
    height: 18px;
    border-radius: 9px;
    background-color: #000000;
    border-width: 1px;
    border-color: #3a3a3a;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 2px;
  }

  .toggle-disabled-knob {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #2a2a2a;
  }

  .desc-text {
    color: #888888;
    font-size: 10px;
    line-height: 13px;
  }

  .bottom-spacer {
    width: 176px;
    height: 30px;
  }

  .spacer-text {
    font-size: 1px;
  }

  /* ==== 字号与按键放大 / 更圆角 ==== */
  .header-title { font-size: 22px; }
  .settings-list { height: 428px; }
  .setting-item { height: 62px; border-radius: 22px; padding-left: 10px; padding-right: 8px; }
  .setting-label { font-size: 13px; }
  .toggle-img { width: 34px; height: 17px; }
  .toggle-disabled { width: 34px; height: 17px; border-radius: 9px; }
  .toggle-disabled-knob { width: 11px; height: 11px; border-radius: 6px; }
  .desc-text { font-size: 11px; line-height: 14px; }
  .desc-item { height: 30px; }

  /* ==== 顶栏返回键适配 ==== */
  .header-bar { margin-top: 50px; }
  .settings-list { height: 378px; }

  /* ==== 置顶返回键（加大） ==== */
  .page {
    position: relative;
  }

  .top-back {
    position: absolute;
    top: 2px;
    left: 74px;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(100, 149, 237, 0.42);
    border-width: 2px;
    border-color: #6495ed;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }

  .top-back-text {
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var KEY_VIBRATION = 'setting_vibration'
  var KEY_AUTOCALC = 'setting_autocalc'
  var KEY_SMOOTH = 'setting_smooth_curve'

  export default {
    goBack() {
      router.back()
    },

    private: {
      vibrationOn: true,
      autoCalcOn: true,
      smoothOn: true
    },

    onBackPress() {
      router.back()
      return true
    },

    onInit() {
      var self = this
      storage.get({
        key: KEY_VIBRATION,
        success: function(data) {
          if (data === 'false') {
            self.vibrationOn = false
          } else {
            self.vibrationOn = true
          }
        },
        fail: function() {
          self.vibrationOn = true
        }
      })
      storage.get({
        key: KEY_AUTOCALC,
        success: function(data) {
          if (data === 'false') {
            self.autoCalcOn = false
          } else {
            self.autoCalcOn = true
          }
        },
        fail: function() {
          self.autoCalcOn = true
        }
      })
      storage.get({
        key: KEY_SMOOTH,
        success: function(data) {
          if (data === 'false') {
            self.smoothOn = false
          } else {
            self.smoothOn = true
          }
        },
        fail: function() {
          self.smoothOn = true
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    toggleVibration() {
      this.vibrationOn = !this.vibrationOn
      this.doVibrate()
      storage.set({
        key: KEY_VIBRATION,
        value: this.vibrationOn ? 'true' : 'false'
      })
    },

    toggleAutoCalc() {
      this.autoCalcOn = !this.autoCalcOn
      this.doVibrate()
      storage.set({
        key: KEY_AUTOCALC,
        value: this.autoCalcOn ? 'true' : 'false'
      })
    },

    toggleSmoothCurve() {
      this.smoothOn = !this.smoothOn
      this.doVibrate()
      storage.set({
        key: KEY_SMOOTH,
        value: this.smoothOn ? 'true' : 'false'
      })
    },

    openReward() {
      this.doVibrate()
      router.push({ uri: '/pages/Reward' })
    },

    openAbout() {
      this.doVibrate()
      router.push({ uri: '/pages/About' })
    }
  }
</script>
